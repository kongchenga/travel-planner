# LLM API Key（必须）
OPENAI_API_KEY=your-api-key-here
# 兼容 OpenAI 的 API 地址（如 DeepSeek / OpenRouter / 硅基流动 等）
# OPENAI_API_BASE=https://api.deepseek.com
# OPENAI_MODEL_NAME=deepseek-chat

# 高德地图 API Key（可选，用于 POI 搜索 / 天气 / 距离查询）
# 注册：https://lbs.amap.com/ -> 创建应用 -> 添加 Key（Web 服务）
# AMAP_KEY=your-amap-key-here

# API 鉴权 Token（可选，生产环境强烈建议设置）
# API_AUTH_TOKEN=your-secret-token
